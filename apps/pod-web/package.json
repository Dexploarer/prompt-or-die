{
  "name": "@prompt-or-die/pod-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync:assets": "bun run scripts/sync-assets.mjs",
    "verify:assets": "bun run scripts/verify-generated-assets.ts",
    "measure:render-routes": "bun run scripts/measure-render-routes.ts",
    "measure:render-routes:check": "bun run scripts/measure-render-routes.ts --fail-on-gates",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:smoke": "playwright test tests/showcase-visual.e2e.ts --config=playwright.config.ts && playwright test tests/worker-input.e2e.ts --config=playwright.config.ts"
  },
  "dependencies": {
    "@toon-format/toon": "^2.1.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/three": "^0.184.0",
    "bun-types": "^1.3.10",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
